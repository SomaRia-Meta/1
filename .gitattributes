# 统一换行符处理，避免 Windows/Linux 协作时的 CRLF 噪音
* text=auto

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# PowerShell 脚本按二进制处理会破坏 BOM，这里显式声明为文本
*.ps1   diff=astextplain

# 图片
*.png binary
*.jpg binary
*.gif binary
*.ico binary
